{
  "name": "html-downloader",
  "version": "1.1.0",
  "type": "module",
  "description": "現在開いているサイトのHTMLをダウンロードします。",
  "scripts": {
    "build": "shx rm -rf dist html_downloader.zip && shx mkdir -p dist && shx cp -r src/* dist/ && bestzip html_downloader.zip dist/*",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run src tests"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ayato-labs/html-downloader.git"
  },
  "author": "Ayato",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@vitest/ui": "^4.1.8",
    "bestzip": "^3.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "semantic-release": "^25.0.3",
    "shx": "^0.4.0",
    "vitest": "^4.1.8"
  }
}
